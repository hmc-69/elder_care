DATABASE_URL="mysql://username:password@localhost:3306/eldercare_connect"
PORT=8000
FRONTEND_ORIGIN="http://localhost:5173"
JWT_SECRET="replace_me_with_a_unique_random_secret_of_32_chars_or_more"
JWT_EXPIRES_IN=1d

# Schedule times use this IANA timezone (set to the elder's local timezone).
APP_TIMEZONE=Asia/Kolkata
CHECKIN_MORNING_TIME="09:00"
CHECKIN_NIGHT_TIME="20:00"
CHECKIN_GRACE_MINUTES=60

# Module 7: AI Assistant Configuration
# Supported providers: gemini, openai, mock
AI_PROVIDER=gemini
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
AI_TIMEOUT_MS=15000
# SOS email alerts via Gmail SMTP (keep credentials in the backend only)
EMAIL_USER="your-gmail-address@gmail.com"
EMAIL_APP_PASSWORD="your-16-character-google-app-password"
EMAIL_FROM_NAME="ElderCare Connect"
